{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aiwg.io/schemas/ops/dev/v1/dev-artifacts.schema.json",
  "title": "Dev operations extension artifacts",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "dev.ops.aiwg.io/v1" },
    "kind": { "enum": ["DevBuildPlaybook"] },
    "metadata": { "$ref": "#/definitions/metadata" },
    "spec": {
      "type": "object",
      "required": ["targets", "steps"],
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string", "minLength": 1 },
        "inventory": { "type": "string", "minLength": 1 },
        "targets": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "groups": { "type": "array", "items": { "type": "string" } },
            "hosts": { "type": "array", "items": { "type": "string" } }
          }
        },
        "vars": { "type": "object", "additionalProperties": true },
        "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/step" } }
      }
    }
  },
  "definitions": {
    "metadata": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "namespace": { "type": "string" },
        "labels": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "step": {
      "description": "OpsPlaybook capability step with structured input bindings and retry policy.",
      "type": "object",
      "required": ["id", "capability"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "capability": { "type": "string", "minLength": 1 },
        "depends_on": { "type": "array", "items": { "type": "string" } },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "value": {},
              "from": {
                "type": "string",
                "pattern": "^(vars\\.[A-Za-z_][A-Za-z0-9_-]*|steps\\.[A-Za-z0-9_-]+\\.outputs\\.[A-Za-z0-9_-]+)$"
              }
            },
            "oneOf": [
              { "properties": { "value": {} }, "required": ["value"], "not": { "properties": { "from": {} }, "required": ["from"] } },
              { "properties": { "from": {} }, "required": ["from"], "not": { "properties": { "value": {} }, "required": ["value"] } }
            ]
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "object", "required": ["name"], "additionalProperties": false,
            "properties": { "name": { "type": "string" } }
          }
        },
        "retry": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "limit": { "type": "integer", "minimum": 0 },
            "backoff": { "type": "string" },
            "on": { "type": "string" }
          }
        },
        "gate": {
          "type": "object",
          "required": ["type", "message", "blast_radius"],
          "additionalProperties": false,
          "properties": {
            "type": { "enum": ["automated", "manual"] },
            "message": { "type": "string", "minLength": 1 },
            "blast_radius": { "enum": ["low", "medium", "high"] }
          }
        }
      }
    }
  }
}
