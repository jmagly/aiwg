{
  "name": "Media Curator",
  "path": "agentic/code/frameworks/media-curator",
  "files": [
    "README.md",
    "plan-act-curator.md"
  ],
  "directories": [
    "agents",
    "commands",
    "config",
    "skills",
    "docs",
    "templates"
  ],
  "ignore": [
    "manifest.json"
  ],
  "memory": {
    "creates": [
      {
        "path": ".aiwg/frameworks/media-curator/",
        "description": "All media curation artifacts root directory"
      },
      {
        "path": ".aiwg/frameworks/media-curator/analysis/",
        "description": "Artist analysis and era breakdowns"
      },
      {
        "path": ".aiwg/frameworks/media-curator/discography/",
        "description": "Canonical album lists with MusicBrainz IDs"
      },
      {
        "path": ".aiwg/frameworks/media-curator/sources/",
        "description": "Ranked source lists per album"
      },
      {
        "path": ".aiwg/frameworks/media-curator/downloads/",
        "description": "Download logs"
      },
      {
        "path": ".aiwg/frameworks/media-curator/tagging/",
        "description": "Metadata tagging logs"
      },
      {
        "path": ".aiwg/frameworks/media-curator/verification/",
        "description": "Verification and integrity logs"
      },
      {
        "path": ".aiwg/frameworks/media-curator/reports/",
        "description": "Completeness and gap reports"
      },
      {
        "path": ".aiwg/frameworks/media-curator/sessions/",
        "description": "Resumable curation session state"
      },
      {
        "path": ".aiwg/frameworks/media-curator/profiles/",
        "description": "Artist profiles saved as YAML"
      },
      {
        "path": ".aiwg/frameworks/media-curator/transcripts/",
        "description": "Transcript sidecars with source/transcript hashes and segment timestamps"
      },
      {
        "path": ".aiwg/frameworks/media-curator/models/",
        "description": "Open-weight model inventory, archival reports, and per-model fixity/PROV receipts"
      }
    ],
    "topology": {
      "namespace": ".aiwg/media",
      "rawSources": ".aiwg/media/sources",
      "derivedPages": {
        "artist": ".aiwg/media/analysis",
        "discography": ".aiwg/media/discography",
        "session": ".aiwg/media/sessions",
        "synthesis": ".aiwg/media/reports",
        "transcripts": ".aiwg/media/transcripts"
      },
      "index": ".aiwg/media/index.md",
      "log": ".aiwg/media/.log.jsonl",
      "crossRefStyle": "at-mention",
      "pageTemplate": "templates/artist-profile.md",
      "lintRules": [
        "link-check",
        "mention-lint"
      ]
    }
  }
}
