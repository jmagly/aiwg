{
  "apiVersion": "decision.aiwg.io/v1alpha1",
  "kind": "DecisionDefinition",
  "metadata": {
    "id": "example-core_unavailable",
    "version": "1.0.0",
    "description": "example core_unavailable"
  },
  "spec": {
    "purpose": "Triage a synthetic support report without performing any action.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "message"
      ],
      "additionalProperties": false
    },
    "question": "Are core application functions unavailable?",
    "answer": {
      "kind": "truth-probability",
      "trueDescription": "Core functions cannot be used.",
      "falseDescription": "Core functions remain usable."
    },
    "requiredCapabilities": [
      "truth-probability"
    ]
  }
}
