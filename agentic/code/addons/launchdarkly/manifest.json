{
  "id": "launchdarkly",
  "type": "addon",
  "name": "LaunchDarkly",
  "version": "2026.11.0",
  "description": "Governed LaunchDarkly onboarding, SDK integration, staged releases, experiments, lifecycle cleanup and read-only governance.",
  "core": false,
  "autoInstall": false,
  "explicitInstall": true,
  "author": "AIWG Contributors",
  "license": "MIT",
  "repository": "https://github.com/jmagly/aiwg",
  "keywords": [
    "launchdarkly",
    "feature flags",
    "onboarding",
    "set up LaunchDarkly",
    "ld-onboarding"
  ],
  "entry": {
    "agents": "agents/",
    "skills": "skills/",
    "rules": "rules/",
    "flows": "flows/",
    "templates": "templates/",
    "fixtures": "fixtures/",
    "docs": "docs/",
    "scripts": "scripts/"
  },
  "agents": [
    "launchdarkly-concierge",
    "launchdarkly-governance-auditor",
    "launchdarkly-release-engineer",
    "launchdarkly-sdk-integrator"
  ],
  "skills": [
    "ld-docs",
    "ld-connect",
    "ld-doctor",
    "ld-account-setup",
    "ld-sdk-integrate",
    "ld-contexts",
    "ld-testing",
    "ld-flag-create",
    "ld-targeting",
    "ld-segments",
    "ld-progressive-rollout",
    "ld-guarded-release",
    "ld-migration-flag",
    "ld-approvals",
    "ld-experiment",
    "ld-agentcontrol",
    "ld-flag-cleanup",
    "ld-flag-debt-audit",
    "ld-code-refs-ci",
    "ld-terraform",
    "ld-relay-proxy",
    "ld-quickref"
  ],
  "rules": [
    "ld-key-safety",
    "ld-change-authorization",
    "ld-docs-currency",
    "ld-flag-hygiene"
  ],
  "flows": [
    "ld-feature-release",
    "ld-flag-cleanup-cycle",
    "ld-governance-maturity",
    "ld-migration",
    "ld-onboarding"
  ],
  "templates": [
    "experiment-readout",
    "flag-debt-report",
    "governance-assessment",
    "launchdarkly-fields",
    "onboarding-record",
    "rollout-plan"
  ],
  "fixtures": [
    "doctor-cases",
    "sdk-node",
    "sdk-python"
  ],
  "dependencies": {
    "required": [],
    "optional": [
      "sdlc-complete"
    ]
  },
  "configuration": {
    "defaults": {
      "feature_flags": {
        "provider": "launchdarkly"
      },
      "writes": "none"
    },
    "providerImplementations": "provider-implementations.json"
  },
  "memory": {
    "creates": [
      {
        "path": ".aiwg/launchdarkly/",
        "description": "Sanitized onboarding records and connection checks under the configured artifact root."
      }
    ]
  }
}
