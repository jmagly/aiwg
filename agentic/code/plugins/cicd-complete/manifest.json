    "cicd-quickref",
    "cicd-intake",
    "ci-assess",
    "ci-pipeline-design",
    "ci-render",
    "ci-drift-check",
    "ci-failure-triage",
    "ci-flake-hunt",
    "ci-migrate",
    "ci-pipeline-audit",
