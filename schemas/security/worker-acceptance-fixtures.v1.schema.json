{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiwg.io/schemas/security/worker-acceptance-fixtures.v1.schema.json",
  "title": "Independent structured worker acceptance fixture manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "policyVersion",
    "goldVersion",
    "provenance",
    "suite",
    "primaryDenominator",
    "cases"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "policyVersion": {
      "const": "REF-3174-v1"
    },
    "goldVersion": {
      "type": "string",
      "minLength": 1
    },
    "primaryDenominator": {
      "const": "schema_field_positions"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit",
        "paths"
      ],
      "properties": {
        "repository": {
          "const": "section9/research-papers"
        },
        "commit": {
          "const": "7f92a62b99d62d14b9c3a4fe499087d654cf6234"
        },
        "paths": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "digest"
      ],
      "properties": {
        "file": {
          "type": "string",
          "pattern": "^[^/\\\\]+\\.json$"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "value"
      ],
      "properties": {
        "state": {
          "enum": [
            "PRESENT",
            "EXPLICIT_NULL",
            "UNKNOWN",
            "KNOWN_EMPTY"
          ]
        },
        "value": {},
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "$ref": "#/$defs/span"
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "metric",
        "severity",
        "type",
        "expected",
        "unknownRepresentations",
        "tagged"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "metric": {
          "enum": [
            "exact",
            "integer",
            "quantity",
            "quote",
            "alias",
            "array"
          ]
        },
        "severity": {
          "enum": [
            "critical",
            "standard"
          ]
        },
        "type": {
          "enum": [
            "string",
            "number",
            "integer",
            "boolean",
            "object",
            "array"
          ]
        },
        "expected": {
          "$ref": "#/$defs/expected"
        },
        "unknownRepresentations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "null",
              "tagged"
            ]
          }
        },
        "tagged": {
          "type": "boolean"
        },
        "absTol": {
          "type": "number",
          "minimum": 0
        },
        "relTol": {
          "type": "number",
          "minimum": 0
        },
        "unit": {
          "type": "string"
        },
        "units": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "whitespace": {
          "enum": [
            "exact",
            "collapse"
          ]
        },
        "itemKey": {
          "type": "string",
          "pattern": "^/"
        },
        "ordered": {
          "type": "boolean"
        },
        "attributes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field"
          }
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "domain",
        "arm",
        "source",
        "sourceDigest",
        "question",
        "schema",
        "schemaDigest",
        "fields"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "arm": {
          "enum": [
            "required",
            "nullable",
            "explicit_unknown",
            "golden"
          ]
        },
        "source": {
          "type": "string"
        },
        "sourceDigest": {
          "$ref": "#/$defs/digest"
        },
        "question": {
          "type": "string"
        },
        "schema": {
          "type": "object"
        },
        "schemaDigest": {
          "$ref": "#/$defs/digest"
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/field"
          }
        }
      }
    }
  }
}
