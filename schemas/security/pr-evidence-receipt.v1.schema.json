{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aiwg.io/schemas/security/pr-evidence-receipt.v1.schema.json",
  "title": "PullRequestEvidenceReceipt",
  "type": "object",
  "required": ["schemaVersion", "head", "base", "acquiredAt", "completedAt", "body", "collection", "paths", "completeness", "scopeTriage", "maliciousness", "claims", "verified", "assessed", "evidenceManifest", "nextAction", "actionTrail", "sha256"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "repository": { "type": "string" },
    "number": { "type": "integer" },
    "head": { "type": "string", "pattern": "^[0-9a-fA-F]{40,64}$" },
    "base": { "type": "string", "pattern": "^[0-9a-fA-F]{40,64}$" },
    "acquiredAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" },
    "body": { "type": "object", "required": ["current", "history"] },
    "collection": { "type": "object" },
    "paths": { "type": "array" },
    "completeness": {
      "type": "object",
      "required": ["complete", "omissions"],
      "properties": {
        "complete": { "type": "boolean" },
        "omissions": { "type": "array", "items": {
          "type": "object", "required": ["surface", "reason", "nextStep"],
          "properties": { "surface": { "type": "string" }, "reason": { "type": "string" }, "nextStep": { "type": "string" } }
        } }
      }
    },
    "scopeTriage": { "type": "object" },
    "maliciousness": { "type": "object" },
    "codeOrigin": { "type": "object" },
    "claims": { "type": "object" },
    "verified": { "type": "object" },
    "assessed": { "type": "array", "items": {
      "type": "object", "required": ["id", "surface", "sha256", "report"],
      "properties": {
        "id": { "type": "string" },
        "surface": { "enum": ["pull-request-title", "pull-request-body", "pull-request-diff-summary", "review-comment"] },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "report": { "type": "object" }
      }
    } },
    "activeFindings": { "type": "array" },
    "evidenceManifest": { "type": "array", "items": {
      "type": "object", "required": ["sourceId", "sha256", "revision"],
      "properties": {
        "sourceId": { "type": "string" }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "revision": { "type": "string" }, "lineCoverage": { "type": "object" }
      }
    } },
    "nextAction": { "type": "object", "required": ["proposed", "gate", "reason"] },
    "actionTrail": { "type": "array", "minItems": 1 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
