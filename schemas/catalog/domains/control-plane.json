{
  "$schema": "../domain-manifest.v1.schema.json",
  "schemaVersion": "1",
  "domain": "schema-control-plane",
  "owner": {
    "id": "aiwg-maintainers"
  },
  "policy": {
    "compatibility": "backward"
  },
  "artifacts": [
    {
      "logicalName": "catalog.schema-artifact",
      "id": "https://aiwg.io/schemas/catalog/schema-artifact.v1.schema.json",
      "version": "1.0.0",
      "format": "json-schema",
      "dialect": "https://json-schema.org/draft/2020-12/schema",
      "lifecycle": "active",
      "stability": "stable",
      "owner": {
        "id": "aiwg-maintainers"
      },
      "authority": {
        "kind": "canonical",
        "path": "schemas/catalog/schema-artifact.v1.schema.json"
      },
      "compatibility": {
        "mode": "backward"
      },
      "consumers": [
        {
          "id": "schema-catalog-compiler",
          "boundary": "catalog manifest"
        }
      ]
    },
    {
      "logicalName": "catalog.domain-manifest",
      "id": "https://aiwg.io/schemas/catalog/domain-manifest.v1.schema.json",
      "version": "1.0.0",
      "format": "json-schema",
      "dialect": "https://json-schema.org/draft/2020-12/schema",
      "lifecycle": "active",
      "stability": "stable",
      "owner": {
        "id": "aiwg-maintainers"
      },
      "authority": {
        "kind": "canonical",
        "path": "schemas/catalog/domain-manifest.v1.schema.json"
      },
      "compatibility": {
        "mode": "backward"
      },
      "dependencies": [
        {
          "id": "https://aiwg.io/schemas/catalog/schema-artifact.v1.schema.json",
          "version": "1.0.0"
        }
      ],
      "consumers": [
        {
          "id": "schema-catalog-loader",
          "boundary": "domain manifest"
        }
      ]
    },
    {
      "logicalName": "catalog.root",
      "id": "https://aiwg.io/schemas/catalog/catalog.v1.schema.json",
      "version": "1.0.0",
      "format": "json-schema",
      "dialect": "https://json-schema.org/draft/2020-12/schema",
      "lifecycle": "active",
      "stability": "stable",
      "owner": {
        "id": "aiwg-maintainers"
      },
      "authority": {
        "kind": "canonical",
        "path": "schemas/catalog/catalog.v1.schema.json"
      },
      "compatibility": {
        "mode": "backward"
      },
      "dependencies": [
        {
          "id": "https://aiwg.io/schemas/catalog/schema-artifact.v1.schema.json",
          "version": "1.0.0"
        },
        {
          "id": "https://aiwg.io/schemas/catalog/domain-manifest.v1.schema.json",
          "version": "1.0.0"
        }
      ],
      "consumers": [
        {
          "id": "schema-catalog-loader",
          "boundary": "root catalog"
        }
      ]
    },
    {
      "logicalName": "rules.rule-frontmatter",
      "id": "https://aiwg.io/schemas/rules/rule-frontmatter.v1.schema.json",
      "version": "1.0.0",
      "format": "json-schema",
      "dialect": "http://json-schema.org/draft-07/schema#",
      "lifecycle": "active",
      "stability": "stable",
      "owner": {
        "id": "aiwg-maintainers"
      },
      "authority": {
        "kind": "canonical",
        "path": "src/rules/rule-frontmatter.schema.json"
      },
      "compatibility": {
        "mode": "backward"
      },
      "consumers": [
        {
          "id": "rule-activation-parser",
          "boundary": "rule source frontmatter"
        }
      ]
    },
    {
      "logicalName": "artifacts.relations",
      "id": "https://aiwg.io/schemas/artifacts/relations.v1.schema.json",
      "version": "1.0.0",
      "format": "json-schema",
      "dialect": "https://json-schema.org/draft/2020-12/schema",
      "lifecycle": "active",
      "stability": "experimental",
      "owner": {
        "id": "aiwg-maintainers"
      },
      "authority": {
        "kind": "canonical",
        "path": "schemas/artifacts/relations.v1.schema.json"
      },
      "compatibility": {
        "mode": "unknown"
      },
      "consumers": [
        {
          "id": "framework-relations",
          "path": "src/artifacts/relations.ts",
          "boundary": "small framework relationship sidecar"
        }
      ]
    },
    {
      "logicalName": "schemas.artifacts.checkpoint.record.v1",
      "id": "https://aiwg.io/schemas/artifacts/checkpoint-record.v1.schema.json",
      "version": "1.0.0",
      "format": "json-schema",
      "dialect": "https://json-schema.org/draft/2020-12/schema",
      "lifecycle": "active",
      "stability": "stable",
      "owner": {
        "id": "schema-artifacts"
      },
      "authority": {
        "kind": "canonical",
        "path": "schemas/artifacts/checkpoint-record.v1.schema.json"
      },
      "policy": {
        "strict": true,
        "remoteReferences": "deny",
        "requireFixtures": true
      },
      "compatibility": {
        "mode": "backward",
        "baseline": "2026.11.1 checkpoint records (without handoff fields)"
      },
      "consumers": [
        {
          "id": "checkpoint-handler",
          "boundary": "Create, list, and recover persisted checkpoint records",
          "path": "src/cli/handlers/checkpoint.ts"
        },
        {
          "id": "checkpoint-handoff",
          "boundary": "Write checkpoint records beside handoff documents",
          "path": "src/cli/handlers/checkpoint-handoff.ts"
        }
      ],
      "fixtures": {
        "valid": [
          "test/fixtures/artifacts/checkpoints/valid/record.2026.11.1.json",
          "test/fixtures/artifacts/checkpoints/valid/record.minimal.json",
          "test/fixtures/artifacts/checkpoints/valid/record.handoff.json"
        ],
        "invalid": [
          "test/fixtures/artifacts/checkpoints/invalid/record.missing-artifacts.json",
          "test/fixtures/artifacts/checkpoints/invalid/record.invalid-date.json",
          "test/fixtures/artifacts/checkpoints/invalid/record.non-string-artifact.json",
          "test/fixtures/artifacts/checkpoints/invalid/record.unpaired-handoff.json",
          "test/fixtures/artifacts/checkpoints/invalid/record.blank-handoff.json"
        ]
      },
      "projections": [
        {
          "kind": "validator",
          "path": "src/cli/handlers/checkpoint-record.ts",
          "generated": false
        },
        {
          "kind": "types",
          "path": "src/cli/handlers/checkpoint-record.ts",
          "generated": false
        }
      ]
    }
  ]
}
