{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiwg.io/schemas/decision/DecisionContextEvidence.v1.schema.json",
  "title": "Decision Context Evidence v1",
  "type": "object",
  "properties": {
    "plan": {
      "type": "object",
      "required": ["schemaVersion", "planDigest", "subject", "partitions"],
      "properties": {
        "schemaVersion": { "const": "decision-context-plan/v1" },
        "planDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "subject": { "type": "string", "minLength": 1 },
        "partitions": { "type": "array", "minItems": 1 }
      }
    },
    "actualUsage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["schemaVersion", "planDigest", "partitionId", "estimatedInputTokens", "actualInputTokens"],
        "properties": {
          "schemaVersion": { "const": "decision-context-usage/v1" },
          "planDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "partitionId": { "type": "string", "minLength": 1 },
          "estimatedInputTokens": { "type": "integer", "minimum": 0 },
          "actualInputTokens": { "type": "integer", "minimum": 0 }
        }
      }
    }
  },
  "required": ["plan", "actualUsage"],
  "additionalProperties": false
}
