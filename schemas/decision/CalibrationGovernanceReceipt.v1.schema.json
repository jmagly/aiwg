{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiwg.io/schemas/decision/CalibrationGovernanceReceipt.v1.schema.json",
  "title": "Calibration Governance Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "receiptId", "sequence", "kind", "alias", "from", "to", "action", "reviewedEvidence", "approvalReference", "eligibilityId", "reasons", "recordedAt", "previousReceiptDigest", "digest"],
  "properties": {
    "schemaVersion": { "const": "decision-calibration-governance-receipt/v1" },
    "receiptId": { "type": "string", "minLength": 1 },
    "sequence": { "type": "integer", "minimum": 1 },
    "kind": { "enum": ["promotion", "rollback"] },
    "alias": { "type": "string", "minLength": 1 },
    "from": { "$ref": "#/$defs/aliasPin" },
    "to": { "$ref": "#/$defs/aliasPin" },
    "action": { "enum": ["promote", "rollback"] },
    "reviewedEvidence": {
      "type": "object", "additionalProperties": false,
      "required": ["evaluationIntegrityReport", "calibrationArtifact", "compatibilityRelation"],
      "properties": {
        "evaluationIntegrityReport": { "$ref": "#/$defs/artifactPin" },
        "calibrationArtifact": { "$ref": "#/$defs/artifactPin" },
        "compatibilityRelation": { "anyOf": [{ "$ref": "#/$defs/artifactPin" }, { "type": "null" }] }
      }
    },
    "approvalReference": { "type": "string", "minLength": 1 },
    "eligibilityId": { "type": ["string", "null"], "minLength": 1 },
    "reasons": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "recordedAt": { "type": "string", "format": "date-time" },
    "previousReceiptDigest": { "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
    "digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "artifactPin": {
      "type": "object", "additionalProperties": false, "required": ["id", "digest"],
      "properties": { "id": { "type": "string", "minLength": 1 }, "digest": { "$ref": "#/$defs/digest" } }
    },
    "aliasPin": {
      "type": "object", "additionalProperties": false, "required": ["aliasRevision", "identityDigest"],
      "properties": { "aliasRevision": { "type": "integer", "minimum": 1 }, "identityDigest": { "$ref": "#/$defs/digest" } }
    }
  }
}
