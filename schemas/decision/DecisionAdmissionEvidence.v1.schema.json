{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiwg.io/schemas/decision/DecisionAdmissionEvidence.v1.schema.json",
  "type": "object",
  "properties": {
    "decision": { "enum": ["admit", "defer", "reject"] },
    "reason": {
      "enum": [
        "admitted", "disabled", "cancelled", "deadline-exceeded", "concurrency",
        "requests-per-minute", "tokens-per-second", "attempts", "batch-size", "cost",
        "unknown-cost", "tokens", "unknown-tokens", "queue-full", "queue-timeout", "invalid-estimate", "request-too-large", "too-many-items",
        "retained-work", "unknown-retained-work",
        "retry-after", "circuit-open", "unconfigured-provider"
      ]
    },
    "queueDelayMs": { "type": "number", "minimum": 0 },
    "active": { "type": "integer", "minimum": 0 },
    "queued": { "type": "integer", "minimum": 0 },
    "estimatedTokens": { "type": ["integer", "null"], "minimum": 0 },
    "estimatedCostUsd": { "type": ["number", "null"], "minimum": 0 },
    "retryPressure": { "type": "integer", "minimum": 0 },
    "breakerState": { "enum": ["closed", "open", "half-open"] },
    "retryAfterMs": { "type": "integer", "minimum": 1, "maximum": 30000 },
    "breakerTransitions": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "properties": {
          "from": { "enum": ["closed", "open", "half-open"] },
          "to": { "enum": ["closed", "open", "half-open"] }
        },
        "required": ["from", "to"],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "decision", "reason", "queueDelayMs", "active", "queued", "estimatedTokens",
    "estimatedCostUsd", "retryPressure", "breakerState"
  ],
  "additionalProperties": false
}
