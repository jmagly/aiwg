{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiwg.io/schemas/decision/CalibrationArtifact.v1.schema.json",
  "title": "Decision Calibration Artifact",
  "type": "object",
  "required": ["schemaVersion", "id", "digest", "identity", "splitProvenance", "profile", "metrics", "effectiveAt", "limitations", "approval"],
  "properties": {
    "schemaVersion": { "const": "decision-calibration-artifact/v1" },
    "id": { "type": "string", "minLength": 1 },
    "digest": { "$ref": "#/$defs/digest" },
    "identity": { "$ref": "#/$defs/identity" },
    "splitProvenance": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "hash", "holdoutAccessedAt"],
      "properties": { "id": { "type": "string", "minLength": 1 }, "hash": { "$ref": "#/$defs/digest" }, "holdoutAccessedAt": { "type": ["string", "null"], "format": "date-time" } }
    },
    "profile": {
      "type": "object", "additionalProperties": false,
      "required": ["minimumTotalSamples", "minimumPerSliceSamples", "powerRule", "confidenceInterval", "maximumCalibrationError", "maximumSelectiveRisk", "expiresAfterDays"],
      "properties": {
        "minimumTotalSamples": { "type": "integer", "minimum": 1 },
        "minimumPerSliceSamples": { "type": "integer", "minimum": 1 },
        "powerRule": { "type": ["string", "null"] },
        "confidenceInterval": {
          "type": "object", "additionalProperties": false, "required": ["method", "level"],
          "properties": { "method": { "type": "string", "minLength": 1 }, "level": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 } }
        },
        "maximumCalibrationError": { "type": "number", "minimum": 0, "maximum": 1 },
        "maximumSelectiveRisk": { "type": "number", "minimum": 0, "maximum": 1 },
        "expiresAfterDays": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "metrics": {
      "type": "object", "additionalProperties": false,
      "required": ["totalSamples", "perSliceSamples", "calibrationError", "selectiveRisk", "confidenceIntervals"],
      "properties": {
        "totalSamples": { "type": "integer", "minimum": 0 }, "perSliceSamples": { "type": "integer", "minimum": 0 },
        "calibrationError": { "type": "number", "minimum": 0 }, "selectiveRisk": { "type": "number", "minimum": 0 },
        "confidenceIntervals": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/interval" } }
      }
    },
    "effectiveAt": { "type": "string", "format": "date-time" },
    "limitations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "approval": {
      "type": "object", "additionalProperties": false, "required": ["state", "reference"],
      "properties": { "state": { "enum": ["observed", "approved", "rejected", "retired"] }, "reference": { "type": ["string", "null"] } }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "namedHash": { "type": "object", "additionalProperties": false, "required": ["id", "hash"], "properties": { "id": { "type": "string", "minLength": 1 }, "hash": { "$ref": "#/$defs/digest" } } },
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["provider", "backend", "actualModel", "primitive", "definitionDigest", "adapterVersion", "dataset", "slice", "calibrator"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 }, "backend": { "type": "string", "minLength": 1 }, "actualModel": { "type": "string", "minLength": 1 },
        "primitive": { "type": "string", "minLength": 1 }, "definitionDigest": { "$ref": "#/$defs/digest" }, "adapterVersion": { "type": "string", "minLength": 1 },
        "dataset": { "$ref": "#/$defs/namedHash" }, "slice": { "$ref": "#/$defs/namedHash" },
        "calibrator": {
          "type": "object", "additionalProperties": false, "required": ["id", "version", "parametersDigest"],
          "properties": { "id": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 }, "parametersDigest": { "$ref": "#/$defs/digest" } }
        }
      }
    },
    "interval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lower", "upper"],
      "properties": {
        "lower": { "type": "number", "minimum": 0, "maximum": 1 },
        "upper": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
