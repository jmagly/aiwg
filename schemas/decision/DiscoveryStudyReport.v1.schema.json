  "$defs": {
    "gateDecision": {
      "enum": [
        "PROMOTE",
        "HOLD",
        "ROLLBACK"
      ]
    }
  },
  "allOf": [
    {
      "description": "An unrun study cannot promote.",
      "properties": {
        "decision": {
          "enum": [
            "HOLD",
            "ROLLBACK"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "upstreamDecision": {
            "const": "ROLLBACK"
          }
        }
      },
      "then": {
        "properties": {
          "decision": {
            "const": "ROLLBACK"
          }
        }
      }
    }
  ]
