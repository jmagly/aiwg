              "type": "null"
            },
            "exploratoryTokens": {
              "type": "null"
            },
            "correctionTurns": {
              "type": "null"
            }
          }
        }
      }
    },
    "slices": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "sampleCount",
          "baseline",
          "alternate"
        ],
        "properties": {
          "id": {
            "enum": [
              "exact-name",
              "high-margin",
              "low-margin",
              "cross-type",
              "hard-negative",
              "no-match"
            ]
          },
          "sampleCount": {
            "const": 0
          },
          "baseline": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "hitAt1",
