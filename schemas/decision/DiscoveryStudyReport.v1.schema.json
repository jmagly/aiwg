    "economics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline",
        "decisionCalls",
        "fallback",
        "downstream",
        "totalTokenSavings",
        "totalCostSavingsUsd",
        "pricingDigest"
