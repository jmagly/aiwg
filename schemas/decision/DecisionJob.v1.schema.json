{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiwg.io/schemas/decision/DecisionJob.v1.schema.json",
  "title": "AIWG Decision Job v1 (contract only; dispatch disabled)",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "id", "scope", "fingerprint", "state", "items", "summary", "createdAtEpochMs", "expiresAtEpochMs", "budget"],
  "properties": {
    "schemaVersion": { "const": "decision-job/v1" },
    "id": { "$ref": "#/$defs/id" },
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["tenantId", "projectId", "workspaceId", "principalId"],
      "properties": { "tenantId": { "$ref": "#/$defs/id" }, "projectId": { "$ref": "#/$defs/id" }, "workspaceId": { "$ref": "#/$defs/id" }, "principalId": { "$ref": "#/$defs/id" } }
    },
    "fingerprint": { "$ref": "#/$defs/digest" },
    "state": { "enum": ["validating", "queued", "running", "partially-completed", "completed", "cancel-requested", "canceled", "expired", "failed"] },
    "items": { "type": "array", "minItems": 1, "maxItems": 1000, "items": { "$ref": "#/$defs/item" } },
    "summary": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 }, "minProperties": 1 },
    "createdAtEpochMs": { "type": "integer", "minimum": 0 },
    "expiresAtEpochMs": { "type": "integer", "minimum": 1 },
    "budget": {
      "type": "object", "additionalProperties": false,
      "required": ["maxAttempts", "maxTokens", "maxCostMicros", "maxConcurrency"],
      "properties": {
        "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "maxTokens": { "type": "integer", "minimum": 1, "maximum": 10000000 },
        "maxCostMicros": { "type": "integer", "minimum": 1, "maximum": 1000000000 },
        "maxConcurrency": { "type": "integer", "minimum": 1, "maximum": 128 }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "item": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "fingerprint", "subjectDigest", "definitionDigest", "bindingDigest", "state", "attempts"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "fingerprint": { "$ref": "#/$defs/digest" },
        "subjectDigest": { "$ref": "#/$defs/digest" },
        "definitionDigest": { "$ref": "#/$defs/digest" }, "bindingDigest": { "$ref": "#/$defs/digest" },
        "rulesetDigest": { "$ref": "#/$defs/digest" },
        "state": { "enum": ["queued", "running", "succeeded", "abstained", "review", "unsupported", "retryable-failed", "permanent-failed", "canceled", "expired", "execution-unknown"] },
        "attempts": { "type": "array", "maxItems": 1000, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["id", "requestDigest", "outcome"],
          "properties": {
            "id": { "$ref": "#/$defs/id" }, "requestDigest": { "$ref": "#/$defs/digest" },
            "receiptDigest": { "$ref": "#/$defs/digest" },
            "reservedTokens": { "type": "integer", "minimum": 0, "maximum": 10000000 },
            "reservedCostMicros": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
            "outcome": { "enum": ["dispatched", "succeeded", "failed", "execution-unknown"] },
            "resolution": {
              "description": "D16 opt-in resolution of an execution-unknown attempt through a verified effect (digest-match only).",
              "type": "object", "additionalProperties": false,
              "required": ["method", "effectId", "reason", "receiptDigest"],
              "properties": {
                "method": { "const": "effect-ledger" },
                "effectId": { "type": "string", "pattern": "^eff1_[a-z2-7]{51}[aq]$" },
                "reason": { "const": "digest-match" },
                "receiptDigest": { "$ref": "#/$defs/digest" }
              }
            }
          }
        } },
        "resultDigest": { "$ref": "#/$defs/digest" },
        "errorCode": { "$ref": "#/$defs/id" }
      }
    }
  }
}
