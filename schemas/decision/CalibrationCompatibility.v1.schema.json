{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiwg.io/schemas/decision/CalibrationCompatibility.v1.schema.json",
  "title": "Pinned Calibration Compatibility Decision",
  "type": "object",
  "required": ["schemaVersion", "pinId", "runId", "requestedAlias", "actualModel", "aliasRevision", "artifactId", "artifactDigest", "state", "action", "reasons", "decidedAt"],
  "properties": {
    "schemaVersion": { "const": "decision-calibration-compatibility/v1" },
    "pinId": { "type": "string", "minLength": 1 }, "runId": { "type": "string", "minLength": 1 },
    "requestedAlias": { "type": "string", "minLength": 1 }, "actualModel": { "type": "string", "minLength": 1 },
    "aliasRevision": { "type": ["integer", "null"], "minimum": 1 }, "artifactId": { "type": ["string", "null"] },
    "artifactDigest": { "anyOf": [{ "type": "null" }, { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }] },
    "state": { "enum": ["exact", "approved-compatible", "shadow-required", "incompatible", "unknown"] },
    "action": { "enum": ["allow", "fail", "defer", "shadow", "require-approval"] },
    "reasons": { "type": "array", "items": { "type": "string", "minLength": 1 } }, "decidedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
