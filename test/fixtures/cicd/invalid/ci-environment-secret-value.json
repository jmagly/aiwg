{
  "apiVersion": "cicd.aiwg.io/v1",
  "kind": "CIEnvironment",
  "metadata": {
    "name": "ci-production",
    "labels": {
      "tier": "production"
    }
  },
  "spec": {
    "runner": {
      "labels": [
        "linux",
        "ci-runner"
      ]
    },
    "secrets": [
      {
        "name": "CI_TOKEN",
        "ref": "vault://ci/production#token",
        "value": "ci-literal-example"
      }
    ],
    "protection": {
      "required_reviewers": 2,
      "branch_restrictions": [
        "main",
        "release/*"
      ]
    }
  }
}
