# AIWG project artifacts
#
# AIWG's own SDLC corpus moved out of the public product repository into the
# private release-ops repository at:
#
#   ../aiwg-web-release-ops/corpus/.aiwg
#
# Maintainer checkouts should use a local `.aiwg-location` pointer to that
# directory. AIWG_ARTIFACTS_PATH remains available as a temporary override.
# Public clones can build and test without private corpus access.
.aiwg/
.aiwg-location

# Agent temporary files
_agent-temp/
docs/references/pdfs/*.pdf

# Test temp directories (created by file watcher tests)
test-temp-watch-*/
test/**/.tmp-*/

# AIWG high-churn runtime state is covered by the top-level .aiwg/ ignore.

# RLM working dir — `aiwg rlm-prep` writes per-host chunks/manifests with
# absolute paths; reproducible from re-running the command.
.rlm-prep/

# stale docs preview build target (active target is dist/aiwg-docs)
.docs-preview/
